---
// About & Services (spec screen 2; mockup "About").
import { getImage } from 'astro:assets';
import { Button } from '../components/Button';
import { EmptyState } from '../components/EmptyState';
import type { IconName } from '../components/Icon';
import { ListRow } from '../components/ListRow';
import { ProjectCard } from '../components/ProjectCard';
import { ServiceCard } from '../components/ServiceCard';
import { StepList } from '../components/StepList';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getNewestProjects } from '../data/projects';
import { site, telHref, whatsappHref } from '../data/site';

const branches = site.branches.join(' · ');
/** "Nairobi, Nakuru and Eldoret" */
const branchList = `${site.branches.slice(0, -1).join(', ')} and ${site.branches.at(-1)}`;

const services: { id: string; service: string; icon: IconName; title: string; text: string; points: string[] }[] = [
  {
    id: 'farms', service: 'farm', icon: 'sprout', title: 'Solar for farms',
    text: 'Solar irrigation pumps that put water on your crops every day.',
    points: ['Pump and panels sized for your water needs', 'Borehole, well or river', 'Protected and tested on site'],
  },
  {
    id: 'homes', service: 'home', icon: 'house', title: 'Homes',
    text: 'Safe wiring and reliable power for your family.',
    points: ['New wiring and rewiring', 'Solar and backup power', 'Every circuit tested'],
  },
  {
    id: 'businesses', service: 'commercial', icon: 'factory', title: 'Commercial and industrial',
    text: 'Power for the machines that keep your business running.',
    points: ['Shops, offices, workshops', 'Machines and three-phase power', 'Commissioned before handover'],
  },
  {
    id: 'websites', service: 'digital', icon: 'smartphone', title: 'Websites and mobile apps',
    text: 'A clear website or app for your business.',
    points: ['Company websites', 'Mobile apps', 'Plain, quick to use on a phone'],
  },
];

// Newest six completed projects; photos resized and compressed at build time.
const projects = await Promise.all(
  (await getNewestProjects()).map(async p => {
    const img = p.data.photo ? await getImage({ src: p.data.photo, width: 600, format: 'webp', quality: 72 }) : null;
    return { ...p.data, id: p.id, img };
  }),
);
---
<BaseLayout
  title="About & Services"
  description="Licensed electrical engineers (EPRA, EBK) in Nairobi, Nakuru and Eldoret. Solar for farms, homes, businesses, websites and apps. See our completed projects."
  current="about"
>
  <!-- Who we are -->
  <section class="hero">
    <div class="page">
      <div class="hero__panel">
        <div class="hero__copy">
          <p class="eyebrow hero__eyebrow">About ASILI</p>
          <h1 class="hero__title about-title">Engineers who size it, protect it and test it.</h1>
          <p class="hero__lead">
            “Asili” means roots in Swahili. We are a local team of licensed electrical engineers in {branchList}.
            We speak plainly, we calculate before we install, and we only hand over a system once it has been tested
            and commissioned.
          </p>
        </div>
        <div class="credentials">
          <ListRow onBrand icon="badge-check" title="EPRA licensed electrical engineers" meta="Energy and Petroleum Regulatory Authority" />
          <ListRow onBrand icon="graduation-cap" title="EBK registered engineers" meta="Engineers Board of Kenya" />
          <ListRow onBrand icon="map-pin" title={branches} meta="Three branches, one call away" divider={false} />
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section" aria-labelledby="services">
    <div class="page">
      <p class="eyebrow section__eyebrow">Our services</p>
      <h2 id="services" class="section__title">What we design, install and commission</h2>
      <div class="cards cards--four">
        {services.map(s => (
          <div id={s.id} class="cards__slot">
            <ServiceCard icon={s.icon} title={s.title} points={s.points} href={`/enquiry?service=${s.service}`} linkLabel="Ask about this">
              {s.text}
            </ServiceCard>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How we work -->
  <section class="how" aria-labelledby="how">
    <div class="page">
      <div class="panel how__panel">
        <div>
          <p class="eyebrow panel__eyebrow">How we work</p>
          <h2 id="how" class="panel__title how__title">Design, install, test, commission. Every time.</h2>
        </div>
        <StepList onBrand direction="row" />
      </div>
    </div>
  </section>

  <!-- Completed projects -->
  <section class="section section--white projects" aria-labelledby="projects">
    <div class="page">
      <p class="eyebrow section__eyebrow">Completed projects</p>
      <h2 id="projects" class="section__title">Our recent work</h2>
      {projects.length > 0
        ? (
          <ul class="strip" role="list" tabindex="0" aria-label="Completed projects, newest first. Scroll sideways for more.">
            {projects.map(p => (
              <li>
                <ProjectCard
                  title={p.title}
                  type={p.type}
                  location={p.location}
                  description={p.description}
                  photo={p.img?.src}
                  photoWidth={p.img ? Number(p.img.attributes.width) : undefined}
                  photoHeight={p.img ? Number(p.img.attributes.height) : undefined}
                  width={300}
                />
              </li>
            ))}
          </ul>
        )
        : (
          <EmptyState icon="sun" title="Photos of our recent work are coming soon">
            Ask us about a job like yours and we will tell you how we would do it.
            <Button slot="action" variant="secondary" iconLeft="whatsapp" href={whatsappHref()}>WhatsApp us</Button>
          </EmptyState>
        )}
    </div>
  </section>

  <!-- Closing call to action -->
  <section class="closing" aria-labelledby="closing">
    <div class="page">
      <div class="panel">
        <div class="closing__text">
          <h2 id="closing" class="panel__title">Ready to talk about your project?</h2>
        </div>
        <div class="actions">
          <Button size="lg" iconRight="arrow-right" href="/enquiry" fullWidth>Send an enquiry</Button>
          <Button size="lg" variant="onBrand" iconLeft="phone" href={telHref()} fullWidth>Call</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Shared blocks (hero, section, cards, actions, panel, closing) are in src/styles/page.css */
  .about-title { font-size: clamp(36px, 4.5vw, 56px); }
  .credentials { background: rgba(255, 255, 255, .08); border-radius: var(--radius-lg); padding: var(--space-2) var(--space-5); }

  .cards--four { grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); }

  .how { padding-bottom: 56px; }
  .how__panel { display: flex; flex-direction: column; gap: var(--space-6); }
  .how__title { font-size: clamp(28px, 3.5vw, 42px); }

  .strip {
    list-style: none; margin: 0; padding: 0 0 var(--space-3);
    display: flex; gap: var(--space-4); overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain;
    border-radius: var(--radius-lg);
  }
  .strip > li { flex: none; scroll-snap-align: start; display: flex; }
  .strip:focus-visible { box-shadow: var(--focus-ring); }
  @media (max-width: 599.98px) {
    /* Show a bit of the next card so it's clear the strip scrolls */
    .strip > li > :global(.a-project) { width: 280px !important; }
  }
</style>
